# =============================================================================
# KLTN — cấu hình dùng chung cho CẢ BA HỆ
#
#   cp .env.example .env    rồi điền giá trị
#
# File .env KHÔNG được commit. Sinh bí mật:  openssl rand -base64 32
# =============================================================================

# ── Cổng mở ra máy host ──────────────────────────────────────────────────
# giao diện Ecommerce — điểm vào duy nhất của app
CLIENT_PORT=3000
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
# 9000 đụng MinIO nên đổi
CLICKHOUSE_TCP_PORT=9010
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
# gateway: một cổng cho web, /api, /ai-rec, /ai-bot (xem gateway/nginx.conf).
# Để trống GATEWAY_BIND_IP = chỉ localhost. Đặt IP Tailscale của máy
# (tailscale ip -4) để máy cùng tailnet gọi được. Không đặt 0.0.0.0.
GATEWAY_PORT=8000
GATEWAY_BIND_IP=

# ── PostgreSQL — nguồn dữ liệu của cả hệ thống ───────────────────────────
POSTGRES_DB=getshopy
POSTGRES_USER=getshopy
POSTGRES_PASSWORD=

# ── ClickHouse — analytics + warehouse ───────────────────────────────────
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── MinIO — data lake, nơi Kafka Connect ghi parquet ─────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=data-lake
MINIO_REGION=us-east-1

# ── CDC ──────────────────────────────────────────────────────────────────
# Bảng Prisma đặt tên PascalCase có quote. Viết sai hoa thường thì Debezium
# IM LẶNG không bắt bảng nào.
CDC_TOPIC_PREFIX=cdc_prod
CDC_TABLES=public.Order,public.OrderItem

# ── Ứng dụng ─────────────────────────────────────────────────────────────
NODE_ENV=development
# BẮT BUỘC — server không khởi động nếu thiếu. openssl rand -base64 48
JWT_SECRET=

# ── Cân bằng tải: N bản server sau gateway (18/11/2026) ──────────────────
# Xem docs/load-balancing.md. Để trống = mặc định trong docker-compose.yml.
# Số bản server (mặc định 3). Đổi thì sửa cả số 3 của cảnh báo "Thiếu server" trong
# monitoring/grafana/provisioning/alerting/rules.yml (Grafana không đọc biến trong file luật).
SERVER_REPLICAS=
# Pool Prisma MỖI bản (mặc định 10, tối thiểu 2). Tổng SERVER_REPLICAS x giá trị này
# + ai-bot + Debezium phải dưới max_connections = 100 của Postgres.
SERVER_DB_CONNECTION_LIMIT=
# Header X-Served-By = id container (mặc định 1 = bật; cổng public 8090 luôn gỡ). 0 = tắt.
SERVED_BY_HEADER=
# Mốc cứng khi tắt êm (ms, mặc định 8000) — phải nhỏ hơn stop_grace_period 12 s
SERVER_SHUTDOWN_TIMEOUT_MS=

# ── Giám sát: Prometheus + Grafana (19/11/2026) ──────────────────────────
# Xem docs/monitoring.md. Để trống = mặc định trong docker-compose.yml.
# Mật khẩu admin Grafana — ĐẶT TRƯỚC lần `docker compose up` đầu tiên: Grafana chỉ đọc biến
# này khi tạo tài khoản admin (volume grafana_data còn trống). Để trống = "admin" (Grafana đòi
# đổi ở lần đăng nhập đầu). Sinh: openssl rand -base64 24
GRAFANA_ADMIN_PASSWORD=
# Cổng Grafana trên máy (mặc định 3001, CHỈ nghe 127.0.0.1)
GRAFANA_PORT=
# Số đo Prometheus của server (mặc định 1 = bật; cổng 9464 chỉ trong network Docker). 0 = tắt.
METRICS_ENABLED=
# Prometheus giữ dữ liệu theo thời gian VÀ dung lượng, chạm mức nào trước thì xoá cũ trước
# (mặc định 7d và 1GB)
PROMETHEUS_RETENTION_TIME=
PROMETHEUS_RETENTION_SIZE=

# ── Log tập trung + cảnh báo email (19/11/2026) — docs/monitoring.md mục 10, 11 ──
# Email cảnh báo dùng LẠI máy gửi SMTP_* ở mục "Gửi email" bên dưới (cổng 465 = TLS ngay từ đầu).
# Địa chỉ gửi — CHỈ địa chỉ, không tên, không ngoặc (Gmail: chính SMTP_USER).
ALERT_EMAIL_FROM=
# Hộp thư nhận cảnh báo (nhiều địa chỉ: ngăn bằng dấu ;). Trống = gửi tới một địa chỉ .invalid
# (không ai nhận) — Grafana vẫn chạy; contact point rỗng thì Grafana KHÔNG khởi động được.
ALERT_EMAIL_TO=
# Log request của server: json (mặc định, cho Loki) | dev (morgan như trước)
SERVER_LOG_FORMAT=

# ── Thanh toán VietQR ────────────────────────────────────────────────────
# VietQR KHÔNG phải dịch vụ cần đăng ký — chỉ là chuẩn QR của Napas. Ba giá
# trị này là thông tin tài khoản của chính bạn.
# BIN: MB 970422 · VCB 970436 · TCB 970407 · ACB 970416 · VietinBank 970415
VIETQR_BANK_BIN=
# PHẢI đúng tài khoản đã liên kết SePay
VIETQR_ACCOUNT_NO=
# VIẾT HOA KHÔNG DẤU
VIETQR_ACCOUNT_NAME=

# Tiền tố bắt buộc với một số ngân hàng. VietinBank: SePay chỉ nhận được biến
# động số dư khi nội dung chuyển khoản bắt đầu bằng SEVQR.
PAYMENT_CONTENT_PREFIX=

# đồng hồ khách thấy
PAYMENT_DISPLAY_TTL_SECONDS=300
# server giữ kho lâu hơn, hấp thụ độ trễ ngân hàng
PAYMENT_RESERVATION_TTL_SECONDS=480
PAYMENT_EXPIRE_SCAN_INTERVAL_SECONDS=60
# chặn spam khoá kho
MAX_PENDING_ORDERS_PER_CUSTOMER=3

# ── Webhook SePay — đặt MỘT trong hai, HMAC được ưu tiên ─────────────────
SEPAY_WEBHOOK_HMAC_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_ALLOWED_IPS=

# Adapter mô phỏng, tự tắt khi NODE_ENV=production
PAYMENT_SIMULATOR_KEY=

# ── AI-Rec đọc ClickHouse ────────────────────────────────────────────────
AI_REC_CH_USER=ai_rec
AI_REC_CH_PASSWORD=
# Tín hiệu hành vi phụ: none | count | dwell | dwell+cart
CF_BEHAVIOR_MODE=none
CF_BEHAVIOR_VIEW_WEIGHT=0.25
CF_BEHAVIOR_CART_WEIGHT=1.0
CF_BEHAVIOR_WISH_WEIGHT=0.5

# ── Gợi ý realtime giai đoạn 2: server gửi hành vi gần đây cho AI-Rec (16/11/2026) ──
# Server đọc lượt xem (kèm dwell) + thêm giỏ của khách đã đăng nhập từ ClickHouse
# analytics.user_events và món yêu thích từ Postgres "Wishlist", rồi gọi
# POST /api/v1/recommend/realtime-behavior (lỗi thì /realtime, rồi GET, rồi rule-based).
# Để TRỐNG = dùng mặc định ghi bên cạnh. Đổi giá trị thì khởi động lại server.
# Chỉ lấy hành vi trong N giờ gần nhất (1–2160; mặc định 72 — khách quay lại sau vài ngày vẫn còn hành vi)
AI_REC_BEHAVIOR_WINDOW_HOURS=
# Số sự kiện thô mới nhất được xét (0–500; mặc định 100). 0 = TẮT giai đoạn 2, chỉ gửi món đã mua
AI_REC_BEHAVIOR_MAX_EVENTS=
# Lượt xem có tổng dwell dưới N giây bị bỏ, coi như bấm nhầm (1–600; mặc định 5)
AI_REC_BEHAVIOR_MIN_DWELL_SECONDS=

# ── AI (tuỳ chọn) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# Chu kỳ chạy dbt build của scheduler
DBT_SCHEDULE=5m

# ── Trần RAM (tuỳ chọn; để trống = mặc định cho Docker 7,8 GB) ───────────
# Đặt 08/10/2026 sau khi đợt seed lớn làm máy ảo Docker cạn RAM và kernel diệt
# ClickHouse / Kafka Connect. Mặc định đã đủ cho bộ demo 2,77 triệu đơn (đo: truy vấn
# dbt nặng nhất 1,56 GB, có tràn đĩa). Docker 16 GB thì dùng cột phải cho nhanh hơn
# (ít tràn đĩa) và dư chỗ cho dashboard truy vấn song song.
#                                     Docker 7,8 GB      Docker 16 GB
# CLICKHOUSE_MEM_LIMIT=               3g                 8g
# CLICKHOUSE_QUERY_MAX_MEMORY=        2000000000         6000000000   (byte, mỗi truy vấn — gồm dbt)
# CLICKHOUSE_SPILL_BYTES=             1000000000         3000000000   (quá ngưỡng thì sort/GROUP BY tràn ra đĩa)
# CLICKHOUSE_QUERY_MAX_THREADS=       4                  6
# KAFKA_CONNECT_MEM_LIMIT=            1536m              (giữ — đỉnh đo được 780 MB)
# KAFKA_CONNECT_HEAP_OPTS=            -Xms256m -Xmx1g    (giữ)
# PROMETHEUS_MEM_LIMIT=               512m               (giữ — docs/monitoring.md)
# GRAFANA_MEM_LIMIT=                  512m               (giữ)
# LOKI_MEM_LIMIT=                     512m               (giữ)
# ALLOY_MEM_LIMIT=                    256m               (giữ)
# BLACKBOX_MEM_LIMIT=                 64m                (giữ)

# ── Đăng nhập bằng Google (tuỳ chọn) ─────────────────────────────────────
# Lấy tại Google Cloud Console > APIs & Services > Credentials >
#   Create credentials > OAuth client ID > Web application
# Thêm vào "Authorized JavaScript origins": http://localhost:3000
#
# Client ID KHÔNG phải secret — nó nằm công khai trong bundle trình duyệt theo
# đúng thiết kế của OAuth. Client SECRET mới là bí mật, và luồng ID token ở đây
# không dùng tới nó, nên không cần đặt.
#
# Hai biến dưới đây là CÙNG MỘT GIÁ TRỊ, phải khớp nhau:
#   VITE_GOOGLE_CLIENT_ID — trình duyệt dùng để mở popup Google (nhúng lúc build)
#   GOOGLE_CLIENT_ID      — server dùng làm `audience` khi verify token
# Lệch nhau thì server từ chối mọi token với lỗi "không hợp lệ".
# Để trống = tắt đăng nhập Google, nút sẽ tự ẩn.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# ── Gửi email (SMTP) — "Quên mật khẩu" bằng mã OTP (thêm 12/11/2026) ─────
# Để TRỐNG SMTP_HOST hoặc MAIL_FROM = tắt gửi email: POST /api/b2c/auth/forgot-password
# trả 503 "chức năng gửi email chưa được cấu hình" (server ghi cảnh báo vào log).
#
# Ví dụ Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true,
# SMTP_USER=<địa chỉ Gmail>, SMTP_PASS=<Mật khẩu ứng dụng 16 ký tự, viết liền>.
# Mật khẩu ứng dụng: bật Xác minh 2 bước cho tài khoản Google rồi tạo ở
# https://myaccount.google.com/apppasswords (https://support.google.com/accounts/answer/185833).
# KHÔNG dùng mật khẩu đăng nhập Gmail. Gmail giới hạn 500 thư/ngày
# (https://support.google.com/mail/answer/22839).
#
# SMTP_PASS là BÍ MẬT: chỉ đặt trong .env, không commit, không dán vào chat.
SMTP_HOST=
# 465 = TLS ngay từ đầu (SMTP_SECURE=true) · 587 = STARTTLS (SMTP_SECURE=false).
# Để trống: cổng 587; SMTP_SECURE trống thì tự bật khi cổng là 465.
SMTP_PORT=
SMTP_SECURE=
# Đặt cả hai hoặc bỏ trống cả hai (máy SMTP không cần đăng nhập, vd. Mailpit khi dev)
SMTP_USER=
SMTP_PASS=
# Người gửi hiển thị, KHÔNG đặt trong ngoặc kép, ví dụ: Getshopy <ten.ban@gmail.com>
# Gmail luôn gửi bằng địa chỉ SMTP_USER (trừ địa chỉ đã khai "Gửi thư bằng" trong Gmail).
MAIL_FROM=
# Địa chỉ https của cửa hàng — nút "Truy cập cửa hàng" trong email (để trống thì ẩn nút)
STORE_URL=

# ── Dữ liệu seed cố định ─────────────────────────────────────────────────
# Mọi script seed dùng PRNG có hạt giống thay cho Math.random(), nên cùng một
# giá trị dưới đây thì MỌI MÁY sinh ra đúng cùng bộ 600.000 sản phẩm — điều
# kiện bắt buộc để số liệu trong báo cáo tái lập được.
#
# Để TRỐNG = dùng mặc định 'kltn-getshopy-2026' (khuyến nghị: cứ để trống).
# Đổi giá trị = ra một bộ dữ liệu HOÀN TOÀN KHÁC. Chỉ đổi khi muốn bộ thứ hai
# để so sánh, và phải ghi lại giá trị đã dùng, nếu không sẽ không dựng lại được.
SEED_RANDOM_SEED=
# Mốc thời gian cho dữ liệu seed (flash sale...). Để trống = 2026-01-01T00:00:00Z
SEED_BASE_DATE=

# Chu kỳ gộp phần thừa ReplacingMergeTree. Để trống = 1h.
CH_OPTIMIZE_SCHEDULE=

# Sao lưu Postgres tự động (mặc định 24h, giữ 7 bản trong ./backups/)
PG_BACKUP_SCHEDULE=
PG_BACKUP_KEEP=
