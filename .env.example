# =============================================================================
# KLTN — cấu hình dùng chung cho CẢ BA HỆ
#
#   cp .env.example .env    rồi điền giá trị
#
# File .env KHÔNG được commit. Sinh bí mật:  openssl rand -base64 32
# =============================================================================

# ── Cổng mở ra máy host ──────────────────────────────────────────────────
# giao diện Ecommerce — điểm vào duy nhất của app
CLIENT_PORT=3000
POSTGRES_PORT=5432
CLICKHOUSE_HTTP_PORT=8123
# 9000 đụng MinIO nên đổi
CLICKHOUSE_TCP_PORT=9010
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
KAFKA_PORT=9092
KAFKA_CONNECT_PORT=8083
# 3000 đã dành cho client
METABASE_PORT=3001

# ── PostgreSQL — nguồn dữ liệu của cả hệ thống ───────────────────────────
POSTGRES_DB=getshopy
POSTGRES_USER=getshopy
POSTGRES_PASSWORD=

# ── ClickHouse — analytics + warehouse ───────────────────────────────────
CLICKHOUSE_DB=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── MinIO — data lake, nơi Kafka Connect ghi parquet ─────────────────────
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=data-lake
MINIO_REGION=us-east-1

# ── CDC ──────────────────────────────────────────────────────────────────
# Bảng Prisma đặt tên PascalCase có quote. Viết sai hoa thường thì Debezium
# IM LẶNG không bắt bảng nào.
CDC_TOPIC_PREFIX=cdc_prod
CDC_TABLES=public.Order,public.OrderItem

# ── Ứng dụng ─────────────────────────────────────────────────────────────
NODE_ENV=development
# BẮT BUỘC — server không khởi động nếu thiếu. openssl rand -base64 48
JWT_SECRET=

# ── Thanh toán VietQR ────────────────────────────────────────────────────
# VietQR KHÔNG phải dịch vụ cần đăng ký — chỉ là chuẩn QR của Napas. Ba giá
# trị này là thông tin tài khoản của chính bạn.
# BIN: MB 970422 · VCB 970436 · TCB 970407 · ACB 970416 · VietinBank 970415
VIETQR_BANK_BIN=
# PHẢI đúng tài khoản đã liên kết SePay
VIETQR_ACCOUNT_NO=
# VIẾT HOA KHÔNG DẤU
VIETQR_ACCOUNT_NAME=

# Tiền tố bắt buộc với một số ngân hàng. VietinBank: SePay chỉ nhận được biến
# động số dư khi nội dung chuyển khoản bắt đầu bằng SEVQR.
PAYMENT_CONTENT_PREFIX=

# đồng hồ khách thấy
PAYMENT_DISPLAY_TTL_SECONDS=300
# server giữ kho lâu hơn, hấp thụ độ trễ ngân hàng
PAYMENT_RESERVATION_TTL_SECONDS=480
PAYMENT_EXPIRE_SCAN_INTERVAL_SECONDS=60
# chặn spam khoá kho
MAX_PENDING_ORDERS_PER_CUSTOMER=3

# ── Webhook SePay — đặt MỘT trong hai, HMAC được ưu tiên ─────────────────
SEPAY_WEBHOOK_HMAC_SECRET=
SEPAY_WEBHOOK_API_KEY=
SEPAY_ALLOWED_IPS=

# Adapter mô phỏng, tự tắt khi NODE_ENV=production
PAYMENT_SIMULATOR_KEY=

# ── AI-Rec đọc ClickHouse ────────────────────────────────────────────────
AI_REC_CH_USER=ai_rec
AI_REC_CH_PASSWORD=

# ── AI (tuỳ chọn) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# MinIO phát hành trên quay.io (đã gỡ khỏi Docker Hub công khai)
MINIO_VERSION=latest

# Chu kỳ chạy dbt build của scheduler
DBT_SCHEDULE=5m

# ── Đăng nhập bằng Google (tuỳ chọn) ─────────────────────────────────────
# Lấy tại Google Cloud Console > APIs & Services > Credentials >
#   Create credentials > OAuth client ID > Web application
# Thêm vào "Authorized JavaScript origins": http://localhost:3000
#
# Client ID KHÔNG phải secret — nó nằm công khai trong bundle trình duyệt theo
# đúng thiết kế của OAuth. Client SECRET mới là bí mật, và luồng ID token ở đây
# không dùng tới nó, nên không cần đặt.
#
# Hai biến dưới đây là CÙNG MỘT GIÁ TRỊ, phải khớp nhau:
#   VITE_GOOGLE_CLIENT_ID — trình duyệt dùng để mở popup Google (nhúng lúc build)
#   GOOGLE_CLIENT_ID      — server dùng làm `audience` khi verify token
# Lệch nhau thì server từ chối mọi token với lỗi "không hợp lệ".
# Để trống = tắt đăng nhập Google, nút sẽ tự ẩn.
VITE_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
