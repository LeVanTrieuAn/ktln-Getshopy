# Sao chép thành .env rồi điền giá trị thật.
# .env KHÔNG được commit — xem .gitignore ở gốc repo.
#
# Sinh mật khẩu:  openssl rand -base64 32
POSTGRES_SOURCE_HOST=postgres_mock_source
POSTGRES_SOURCE_PORT=5432
POSTGRES_SOURCE_USER=admin
POSTGRES_SOURCE_PASSWORD=
POSTGRES_SOURCE_DB=app_sales

CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=ch_admin
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DB=default

MINIO_HOST=minio
MINIO_PORT=9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=data-lake
MINIO_REGION=us-east-1

KAFKA_CONNECT_HOST=kafka-connect
KAFKA_CONNECT_PORT=8083

CDC_TOPICS=cdc_prod.public.Order,cdc_prod.public.OrderItem
CDC_PREFIX="topics"
