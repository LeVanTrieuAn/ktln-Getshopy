generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            Int      @id @default(autoincrement())
  full_name     String
  email         String   @unique
  password_hash String
  role          String   @default("admin")
  status        String   @default("active")
  created_at    DateTime @default(now())
}

model B2CCustomer {
  id             BigInt   @id @default(autoincrement())
  full_name      String
  email          String   @unique
  phone          String?
  password_hash  String
  loyalty_points Int      @default(0)
  avatar         String?
  provider       String   @default("local")
  created_at     DateTime @default(now())
}

model Branch {
  id         String   @id
  name       String
  address    String
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
}

model Category {
  id         String   @id
  name       String
  icon       String?
  parent_id  String?  // null = danh mục cấp 1 (cha); có giá trị = danh mục cấp 2 (con)
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  @@index([parent_id])
}

model Brand {
  id         String   @id
  name       String
  is_deleted Boolean  @default(false)
  created_at DateTime @default(now())
}

model Product {
  id             BigInt   @id @default(autoincrement())
  name           String
  price          Int      // VND — đơn vị đồng, không có phần lẻ
  original_price Int      // VND
  category_id    String
  brand_id       String
  stock          Int      @default(0)
  rating         Float    @default(5)
  sold           Int      @default(0)
  image          String?
  images         Json     @default("[]") // Array of strings
  description    String?
  specs          Json     @default("{}") // Structured specs: {screen: "6.7 inch", chip: "A18 Pro", ram: "8GB", ...}
  variants       Json     @default("[]") // Array of variant objects
  branch_ids     Json     @default("[]") // Array of branch strings
  is_banner      Boolean  @default(false)
  is_deleted     Boolean  @default(false)
  created_at     DateTime @default(now())

  @@index([category_id])
  @@index([brand_id])
  @@index([is_deleted, id])
  @@index([price])
}

// ── Wishlist — Implicit Feedback: Deferred purchase intent ────────────
// Phục vụ AI Recommendation: user thêm vào wishlist = interested nhưng chưa mua
model Wishlist {
  id          BigInt   @id @default(autoincrement())
  customer_id BigInt
  product_id  BigInt
  created_at  DateTime @default(now())

  @@unique([customer_id, product_id])
  @@index([customer_id])
}

model Review {
  id         String   @id
  product_id BigInt
  reviewer   String
  rating     Int
  comment    String
  date       DateTime @default(now())
  reply      String?
  reply_date DateTime?
}

model FlashSale {
  id               BigInt   @id @default(autoincrement())
  title            String
  start_time       DateTime
  end_time         DateTime
  product_id       String?
  category_id      String?
  discount_percent Int
  is_deleted       Boolean  @default(false)
}

model FlashSaleItem {
  id             BigInt   @id @default(autoincrement())
  flash_sale_id  BigInt
  product_id     BigInt
  discount_price Int      // VND
  limit          Int      @default(100)
  sold           Int      @default(0)
}

model Order {
  id          String   @id
  customer    Json     // Customer info
  items       Json     // Array of items
  total       Float
  discount    Float    @default(0)
  shippingFee Float    @default(0)
  subTotal    Float    @default(0)
  status      String
  date        DateTime @default(now())
}

model VoucherTier {
  id                     BigInt   @id @default(autoincrement())
  name                   String
  min_points_required    Int      @default(0)
  min_lifetime_spend_vnd Float    @default(0)
  discount_amount_vnd    Float
  active                 Int      @default(1)
}

model Voucher {
  id               BigInt   @id @default(autoincrement())
  code             String   @unique
  min_order_value  Float
  type             String   // "percent" or "fixed"
  value            Float
  max_discount     Float
  is_deleted       Boolean  @default(false)
}

// ── MLOps: Lưu toàn bộ lịch sử cuộc hội thoại Chatbot ──────────────────────
// Phục vụ 2 mục đích:
//   1. Admin theo dõi hành vi người dùng (Data Analytics)
//   2. Nguồn dữ liệu cho quá trình Fine-tune lại model (Continuous Training)
model ChatLog {
  id          BigInt   @id @default(autoincrement())
  session_id  String   // IP hoặc Device fingerprint (nhận diện phiên ẩn danh)
  customer_id BigInt?  // Liên kết B2CCustomer nếu user đã đăng nhập
  message     String   // Nội dung câu hỏi của khách hàng
  response    String   // Câu trả lời của AI Chatbot
  intent      String   // Intent Hugging Face phân loại (VD: SEARCH_PRODUCT)
  score       Float    @default(0) // Độ tự tin (0.0 -> 1.0)
  source      String   @default("huggingface") // rule | cache | huggingface | api_error
  // MLOps Annotation — Admin gán nhãn lại những câu bị phân loại sai
  corrected_intent String? // Nếu Admin sửa lại thì lưu vào đây
  is_annotated     Boolean  @default(false) // Đã được Admin xem xét chưa
  is_trained       Boolean  @default(false) // Đã đưa vào tập dữ liệu train chưa
  created_at  DateTime @default(now())

  @@index([session_id])
  @@index([customer_id])
  @@index([intent])
  @@index([is_annotated])
  @@index([created_at])
}
