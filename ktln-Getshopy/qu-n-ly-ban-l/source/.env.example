# ── Port expose ra máy chủ ────────────────────────────────────────
CLIENT_PORT=5173
SERVER_PORT=8080

# ── Frontend — Vite nhúng vào bundle lúc build ────────────────────
# Phải khớp với SERVER_PORT ở trên
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
# BẮT BUỘC. Middleware xác thực khách hàng sẽ NÉM LỖI nếu thiếu biến này,
# server không khởi động được — đó là chủ ý, secret mặc định trong source
# nghĩa là ai đọc được repo cũng ký được token giả cho mọi tài khoản.
#   Sinh secret:  openssl rand -base64 48
JWT_SECRET=

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=getshopy
POSTGRES_USER=getshopy
POSTGRES_PASSWORD=getshopy_dev_password
# Để trống để server tự tạo URL từ POSTGRES_* ở trên
DATABASE_URL=
DIRECT_URL=

# ── ClickHouse analytics ──────────────────────────────────────────
CLICKHOUSE_DB=analytics

# ── AI (optional) ────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash

# ═══════════════════════════════════════════════════════════════════
# THANH TOÁN
# ═══════════════════════════════════════════════════════════════════

# ── VietQR — KHÔNG cần đăng ký, KHÔNG có API key ───────────────────
# VietQR là chuẩn định dạng QR của Napas (dựa trên EMVCo), không phải
# một dịch vụ. Server tự dựng chuỗi QR và tự tính CRC, không gọi ra
# ngoài. Ba giá trị dưới đây là thông tin tài khoản của chính bạn.
#
# BANK_BIN : mã định danh ngân hàng, đúng 6 chữ số.
#            MB 970422 · Vietcombank 970436 · Techcombank 970407
#            ACB 970416 · VPBank 970432 · TPBank 970423
#            Đối chiếu danh sách chính thức của VietQR/Napas trước khi dùng.
# ACCOUNT_NAME : viết HOA, KHÔNG DẤU (ngân hàng sẽ tự chuẩn hoá như vậy).
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=

# Thời gian sống của một lần thanh toán, tính bằng giây.
# CHECKOUT hiển thị cho khách 300s (5 phút), nhưng server giữ chỗ trong
# kho 480s (8 phút). Khoảng chênh 3 phút là CỐ Ý: chuẩn EMVCo không có
# trường hết hạn, nên khách quét QR ở phút 4:50 mà ngân hàng xử lý xong
# lúc 5:15 là chuyện thường. Chênh lệch này hấp thụ độ trễ đó.
PAYMENT_DISPLAY_TTL_SECONDS=300
PAYMENT_RESERVATION_TTL_SECONDS=480

# ── SePay — ĐÂY mới là thứ phải đăng ký ────────────────────────────
# SePay đọc biến động số dư tài khoản ngân hàng của bạn rồi bắn webhook
# về server. Sau khi đăng ký và liên kết tài khoản, vào phần cấu hình
# Webhook của họ để lấy/đặt API key, rồi dán vào đây.
#
# Endpoint nhận webhook của hệ thống này:
#   POST  <PUBLIC_URL>/api/payment/webhook/sepay
#
# Khi dev ở máy local, SePay không gọi vào localhost được — cần một
# đường hầm công khai:  ngrok http 8080   hoặc   cloudflared tunnel
# rồi khai URL đó bên phía SePay.
#
# KHÔNG có key này thì webhook bị từ chối toàn bộ. Đó là chủ ý: webhook
# không xác thực nghĩa là bất kỳ ai cũng POST được payload giả để tự
# tạo đơn đã thanh toán.
# SePay hỗ trợ 4 kiểu xác thực: HMAC-SHA256, API Key, OAuth 2.0, không xác thực.
# Chọn HMAC-SHA256 nếu được — nó ký lên cả nội dung payload, nên kẻ chặn được
# request cũng không sửa nổi số tiền. API Key chỉ chứng minh người gửi biết bí
# mật, không bảo vệ nội dung.
# TUYỆT ĐỐI không chọn "không xác thực": ai cũng POST được payload giả để tự
# tạo đơn đã thanh toán.
#
# Đặt MỘT trong hai. Nếu có HMAC thì HMAC được ưu tiên.
SEPAY_WEBHOOK_HMAC_SECRET=
SEPAY_WEBHOOK_API_KEY=

# Tuỳ chọn — lớp phòng thủ thứ hai. Danh sách IP của SePay, phân tách
# bằng dấu phẩy. Để trống thì bỏ qua kiểm tra IP.
SEPAY_ALLOWED_IPS=

# ── Adapter mô phỏng — chỉ dùng khi chưa có tài khoản SePay ────────
# Cho phép test toàn bộ luồng thanh toán mà không cần ngân hàng thật.
# Payload mô phỏng đúng cấu trúc webhook thật nên khi cắm SePay vào,
# phần đối soát không phải sửa gì.
#
# TỰ ĐỘNG BỊ TẮT khi NODE_ENV=production — nếu không nó chính là một
# cửa hậu tạo đơn PAID miễn phí.
#   Sinh key:  openssl rand -hex 32
PAYMENT_SIMULATOR_KEY=
