{
  "uid": "getshopy-lb",
  "title": "Getshopy — Cân bằng tải",
  "description": "Gateway nginx chia request cho các bản server như thế nào — request/s, độ trễ, lỗi, CPU/RAM của từng bản. Tài liệu: docs/monitoring.md",
  "tags": [
    "getshopy",
    "load-balancing"
  ],
  "editable": true,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "refresh": "5s",
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "schemaVersion": 41,
  "version": 1,
  "links": [],
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Số bản server thay đổi",
        "datasource": {
          "type": "prometheus",
          "uid": "getshopy-prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "count(up{job=\"getshopy-server\"} == 1) != count(up{job=\"getshopy-server\"} offset 5s == 1)",
        "step": "5s",
        "titleFormat": "Số bản server thay đổi",
        "textFormat": "Xem ô \"Bản server đang chạy\"",
        "useValueForTime": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Tổng quan",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Bản server đang chạy",
      "description": "Số bản server mà Prometheus kéo được số đo (up = 1). Prometheus tìm các bản qua DNS nội bộ của Docker (tên `server`) mỗi 5 s, rồi kéo số đo mỗi 5 s — bản mới hiện ra, bản bị gỡ biến mất sau vài giây.",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "green",
                "value": 2
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum(up{job=\"getshopy-server\"})",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tổng request/s",
      "description": "Tổng số request mọi bản server trả lời mỗi giây (gồm cả healthcheck của Docker: mỗi bản 1 request / 10 s).",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 4,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "p95 toàn cụm",
      "description": "95 % request xong trong thời gian này (tính từ histogram của mọi bản; nội suy trong bucket nên là ước lượng).",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 9,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"getshopy-server\"}[$__rate_interval])))",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Tỷ lệ lỗi 5xx",
      "description": "Phần trăm response 5xx trên tổng response của server. Lỗi do gateway tự sinh (bản không trả lời) KHÔNG nằm ở đây — xem kết quả k6.",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 14,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.001
              },
              {
                "color": "red",
                "value": 0.01
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "(sum(rate(http_requests_total{job=\"getshopy-server\", status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Độ lệch tải giữa các bản",
      "description": "Hệ số biến thiên (CV) của request/s giữa các bản = độ lệch chuẩn / trung bình. 0 % = chia đều tuyệt đối. Chỉ tính khi tổng > 1 request/s (không tính lúc chỉ có healthcheck của Docker, 0,1 request/s mỗi bản) và có >= 2 bản. Ngưỡng màu chỉ để dễ nhìn, không phải tiêu chuẩn.",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 5,
        "x": 19,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "noValue": "không tải",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "red",
                "value": 0.25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "last"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "orientation": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "(stddev(sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))) / avg(sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])))) and on () (sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) > 1)",
          "legendFormat": "",
          "range": true,
          "refId": "A",
          "instant": false
        }
      ]
    },
    {
      "id": 7,
      "type": "row",
      "title": "Phân bố tải giữa các bản",
