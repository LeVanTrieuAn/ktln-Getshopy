          "expr": "(100 * sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) / scalar(sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"}) and on () (sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) > 1)",
          "legendFormat": "{{hostname}}",
