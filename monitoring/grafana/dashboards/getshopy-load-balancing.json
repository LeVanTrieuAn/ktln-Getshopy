    {
      "id": 15,
      "type": "table",
      "title": "Danh sách bản server (hiện tại)",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "description": "Mỗi dòng một bản: tên (= X-Served-By), địa chỉ Prometheus kéo số đo (instance), up, request/s, tỷ trọng, p95, CPU (100 % = một nhân), RAM. Bản bị kill / gỡ biến khỏi DNS nên biến khỏi bảng sau vài giây.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Request/s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "reqps"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Tỷ trọng"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "p95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "CPU"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "RAM (RSS)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "unit",
                "value": "none"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Up"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "green",
                      "value": 1
                    }
                  ]
                }
              },
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "DOWN"
                      },
                      "1": {
                        "text": "UP"
                      }
                    }
                  }
                ]
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "hostname",
            "desc": false
          }
        ]
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "max by (instance, hostname) (up{job=\"getshopy-server\"} * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"}) or on (instance) max by (instance) (up{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance, hostname) (sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance, hostname) (100 * sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) / scalar(sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "C"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance, hostname) (histogram_quantile(0.95, sum by (instance, le) (rate(http_request_duration_seconds_bucket{job=\"getshopy-server\"}[$__rate_interval]))) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "D"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance, hostname) (rate(process_cpu_seconds_total{job=\"getshopy-server\"}[$__rate_interval]) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "E"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance, hostname) (process_resident_memory_bytes{job=\"getshopy-server\"} * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"})",
          "format": "table",
          "instant": true,
          "range": false,
          "refId": "F"
        }
      ],
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "hostname": 0,
              "instance": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5,
              "Value #E": 6,
              "Value #F": 7
            },
            "renameByName": {
              "Value #A": "Up",
              "Value #B": "Request/s",
              "Value #C": "Tỷ trọng",
              "Value #D": "p95",
              "Value #E": "CPU",
              "Value #F": "RAM (RSS)"
            }
          }
        }
      ]
