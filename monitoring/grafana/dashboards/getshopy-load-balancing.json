    {
      "id": 8,
      "type": "timeseries",
      "title": "Request/s mỗi bản",
      "description": "Mỗi đường là một bản server (tên = header X-Served-By = id container). Gateway chia đều thì các đường nằm sát nhau; đường \"Tổng\" (nét đứt) là tổng mọi bản.",
      "datasource": {
        "type": "prometheus",
        "uid": "getshopy-prometheus"
      },
      "gridPos": {
        "h": 10,
        "w": 16,
        "x": 0,
        "y": 6
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 1,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "lineInterpolation": "linear",
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Tổng"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "text"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum by (instance) (rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval])) * on (instance) group_left (hostname) getshopy_server_info{job=\"getshopy-server\"}",
          "legendFormat": "{{hostname}}",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "getshopy-prometheus"
          },
          "expr": "sum(rate(http_requests_total{job=\"getshopy-server\"}[$__rate_interval]))",
          "legendFormat": "Tổng",
          "range": true,
          "refId": "B"
        }
      ]
