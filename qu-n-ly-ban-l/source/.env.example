# ── Port expose ra máy chủ ────────────────────────────────────────
CLIENT_PORT=5173
SERVER_PORT=8080

# ── Frontend — Vite nhúng vào bundle lúc build ────────────────────
# Phải khớp với SERVER_PORT ở trên
VITE_API_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080

# ── Server ────────────────────────────────────────────────────────
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# ── PostgreSQL ────────────────────────────────────────────────────
POSTGRES_DB=getshopy
POSTGRES_USER=getshopy
POSTGRES_PASSWORD=getshopy_dev_password
# Để trống để server tự tạo URL từ POSTGRES_* ở trên
DATABASE_URL=
DIRECT_URL=

# ── ClickHouse analytics ──────────────────────────────────────────
CLICKHOUSE_DB=analytics

# ── AI (optional) ────────────────────────────────────────────────
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
