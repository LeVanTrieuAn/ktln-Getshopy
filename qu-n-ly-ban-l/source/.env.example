# Host ports exposed by Docker Compose
CLIENT_PORT=3000
SERVER_PORT=8081

# Browser-visible addresses. Vite embeds these values when the client image is built.
VITE_API_URL=http://localhost:8081/api
VITE_WS_URL=ws://localhost:8081

# Server settings
NODE_ENV=development
JWT_SECRET=replace-with-a-long-random-secret

# PostgreSQL container and default Prisma connection.
# If DATABASE_URL/DIRECT_URL are blank, the server derives them from the POSTGRES_* values.
POSTGRES_DB=getshopy
POSTGRES_USER=getshopy
POSTGRES_PASSWORD=getshopy_dev_password
DATABASE_URL=
DIRECT_URL=

# ClickHouse analytics database
CLICKHOUSE_DB=analytics

# Optional AI provider configuration. The current source does not read these yet;
# keep them only if a future AI integration needs them.
OPENROUTER_API_KEY=
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
