PORT=8080
JWT_SECRET=replace-with-a-long-random-secret
NODE_ENV=development

# PostgreSQL — khi chạy trực tiếp (không qua Docker)
# Thay user:password@host:port/dbname cho đúng với PostgreSQL local của bạn
DATABASE_URL=postgresql://getshopy:getshopy_dev_password@localhost:5432/getshopy
DIRECT_URL=postgresql://getshopy:getshopy_dev_password@localhost:5432/getshopy

# ClickHouse analytics (optional — chỉ cần cho tính năng analytics B2B)
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=analytics

# Redis cache (OPTIONAL — bỏ trống để chạy không có cache)
# REDIS_URL=redis://localhost:6379

# Hugging Face Inference API — Chatbot NLP Engine
# Đăng ký miễn phí tại: https://huggingface.co/settings/tokens
# Tạo token loại "Read" là đủ.
HF_API_KEY=hf_your_api_key_here

# Model sử dụng cho Intent Classification (zero-shot, hỗ trợ tiếng Việt)
# Kế hoạch: Thay bằng model fine-tuned riêng của Getshopy sau khi training
# Ví dụ model fine-tuned: your-hf-username/getshopy-intent-classifier
HF_MODEL=MoritzLaurer/mDeBERTa-v3-base-mnli-xnli

# Ngưỡng độ tự tin — Dưới ngưỡng này sẽ trả về UNKNOWN
HF_CONFIDENCE_THRESHOLD=0.35

# OpenRouter (giữ lại cho các tính năng LLM khác nếu cần)
# OPENROUTER_API_KEY=sk-or-v1-...
# OPENROUTER_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=google/gemini-2.5-flash
