PORT=8080
JWT_SECRET=your_jwt_secret_here
NODE_ENV=development

# Use localhost when running Node directly; Docker Compose overrides these with
# the service names clickhouse and redis.
CLICKHOUSE_HOST=http://localhost:8123
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=analytics
REDIS_URL=redis://localhost:6379

# Database Connections (PostgreSQL/Prisma)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Reserved for a future OpenRouter integration; the current source does not
# read these values yet.
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
