# Máy POS giả lập — nối vào Postgres của stack hợp nhất ở gốc repo.
#
# Cách đơn giản nhất: KHÔNG tạo .env ở đây, mà chạy script với .env ở gốc:
#     cd ../ && set -a && . ./.env && set +a && python data-platform-poc/pos_simulator.py
#
# Hoặc chép file này thành .env rồi điền. .env KHÔNG được commit.
POS_DB_HOST=localhost
POS_DB_PORT=5432
POS_DB_USER=getshopy
POS_DB_PASSWORD=
POS_DB_NAME=getshopy
